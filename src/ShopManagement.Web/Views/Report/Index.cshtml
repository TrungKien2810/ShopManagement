@model ShopManagement.Application.DTOs.Reports.RevenueSummaryDto
@{
    ViewData["Title"] = "Báo cáo doanh thu";
    var maxRevenue = Model.DailySeries.Any() ? Model.DailySeries.Max(d => d.Revenue) : 0;
}

<div style="margin-bottom: 28px;">
    <h1 style="margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 28px; color: var(--color-primary);">Báo cáo doanh thu</h1>
    <p style="color: var(--color-warm-gray); margin: 4px 0 0; font-size: 14px;">Theo dõi chỉ số kinh doanh, doanh thu thực tế và tần suất đặt hàng theo thời gian.</p>
</div>

<div class="row g-4" style="margin-bottom: 32px;">
    <!-- Stat 1 -->
    <div class="col-md-4 col-sm-6 col-12">
        <div class="linear-card" style="background: #ffffff; border: 1px solid var(--border-normal); border-radius: 14px; padding: 20px; display: flex; align-items: center; justify-content: space-between; transition: all 0.3s ease;"
             onmouseover="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 8px 24px rgba(230, 58, 0, 0.1)';"
             onmouseout="this.style.borderColor='var(--border-normal)'; this.style.boxShadow='var(--shadow-linear)';">
            <div>
                <p style="margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-warm-gray); font-weight: 700;">Doanh thu hôm nay</p>
                <h2 style="margin: 0; font-size: 24px; font-weight: 800; color: var(--color-primary); font-family: var(--font-display);">@Model.TodayRevenue.ToString("N0") đ</h2>
                <div style="margin-top: 8px; display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 13px; font-weight: 600; color: var(--color-warm-white);">@Model.TodayOrderCount đơn hàng</span>
                    <span style="font-size: 11px; color: #22c55e; background: rgba(34, 197, 94, 0.1); padding: 2px 6px; border-radius: 4px; font-weight: 700;">+12.5%</span>
                </div>
            </div>
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 200, 128, 0.05); border: 1px solid rgba(255, 200, 128, 0.1); display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
                <span class="material-symbols-outlined" style="font-size: 24px; font-variation-settings: 'FILL' 1;">payments</span>
            </div>
        </div>
    </div>

    <!-- Stat 2 -->
    <div class="col-md-4 col-sm-6 col-12">
        <div class="linear-card" style="background: #ffffff; border: 1px solid var(--border-normal); border-radius: 14px; padding: 20px; display: flex; align-items: center; justify-content: space-between; transition: all 0.3s ease;"
             onmouseover="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 8px 24px rgba(230, 58, 0, 0.1)';"
             onmouseout="this.style.borderColor='var(--border-normal)'; this.style.boxShadow='var(--shadow-linear)';">
            <div>
                <p style="margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-warm-gray); font-weight: 700;">Doanh thu 7 ngày</p>
                <h2 style="margin: 0; font-size: 24px; font-weight: 800; color: var(--color-warm-white); font-family: var(--font-display);">@Model.WeekRevenue.ToString("N0") đ</h2>
                <div style="margin-top: 8px; display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 13px; font-weight: 600; color: var(--color-warm-gray);">@Model.WeekOrderCount đơn hàng</span>
                    <span style="font-size: 11px; color: #22c55e; background: rgba(34, 197, 94, 0.1); padding: 2px 6px; border-radius: 4px; font-weight: 700;">+8.3%</span>
                </div>
            </div>
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 200, 128, 0.05); border: 1px solid rgba(255, 200, 128, 0.1); display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
                <span class="material-symbols-outlined" style="font-size: 24px;">trending_up</span>
            </div>
        </div>
    </div>

    <!-- Stat 3 -->
    <div class="col-md-4 col-sm-12 col-12">
        <div class="linear-card" style="background: #ffffff; border: 1px solid var(--border-normal); border-radius: 14px; padding: 20px; display: flex; align-items: center; justify-content: space-between; transition: all 0.3s ease;"
             onmouseover="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 8px 24px rgba(230, 58, 0, 0.1)';"
             onmouseout="this.style.borderColor='var(--border-normal)'; this.style.boxShadow='var(--shadow-linear)';">
            <div>
                <p style="margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-warm-gray); font-weight: 700;">Giá trị TB / đơn</p>
                <h2 style="margin: 0; font-size: 24px; font-weight: 800; color: var(--color-warm-white); font-family: var(--font-display);">@Model.AverageOrderValue.ToString("N0") đ</h2>
                <div style="margin-top: 8px; display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 13px; color: var(--color-warm-gray); font-weight: 600;">Giá trị thực tế đơn hoàn thành</span>
                </div>
            </div>
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 200, 128, 0.05); border: 1px solid rgba(255, 200, 128, 0.1); display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
                <span class="material-symbols-outlined" style="font-size: 24px;">receipt</span>
            </div>
        </div>
    </div>
</div>

<div class="linear-card" style="background: #ffffff; border: 1px solid var(--border-normal); border-radius: 16px; padding: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h4 style="margin: 0; font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--color-warm-white); display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 20px;">bar_chart</span>
            Biểu đồ doanh thu 7 ngày gần nhất
        </h4>
        <span style="font-size: 12px; color: var(--color-warm-gray); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Đơn vị: VNĐ</span>
    </div>

    <div style="display:flex; align-items:flex-end; gap:16px; height:240px; padding: 20px 10px 10px; background: var(--color-bg-surface); border-radius: 12px; border: 1px solid var(--border-normal); position: relative;">
        <!-- Vertical guide lines -->
        <div style="position: absolute; left: 0; right: 0; top: 25%; border-top: 1px dashed var(--border-normal); pointer-events: none;"></div>
        <div style="position: absolute; left: 0; right: 0; top: 50%; border-top: 1px dashed var(--border-normal); pointer-events: none;"></div>
        <div style="position: absolute; left: 0; right: 0; top: 75%; border-top: 1px dashed var(--border-normal); pointer-events: none;"></div>

        @foreach (var day in Model.DailySeries)
        {
            var heightPct = maxRevenue > 0 ? (double)day.Revenue / (double)maxRevenue * 100 : 0;
            <div style="flex:1; display:flex; flex-direction:column; align-items:center; height:100%; justify-content:flex-end; position: relative; z-index: 10;">
                <span style="font-size: 11px; color: var(--color-primary); margin-bottom: 8px; font-weight: 700; font-family: var(--font-display); opacity: @(day.Revenue > 0 ? "1" : "0");">
                    @(day.Revenue > 0 ? day.Revenue.ToString("N0") : "")
                </span>
                <div style="width: 100%; max-width: 48px; background: linear-gradient(180deg, var(--color-primary), var(--color-amber)); border-radius: 6px 6px 0 0; height: @(Math.Max(heightPct, 2))%; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; box-shadow: 0 4px 15px rgba(255, 200, 128, 0.1);"
                     onmouseover="this.style.filter='brightness(1.15)'; this.style.boxShadow='0 4px 20px rgba(255, 200, 128, 0.35)';"
                     onmouseout="this.style.filter='none'; this.style.boxShadow='0 4px 15px rgba(255, 200, 128, 0.1)';">
                </div>
                <span style="font-size: 12px; margin-top: 12px; color: var(--color-warm-gray); font-weight: 600;">@(DateTime.TryParse(day.Date, out var d) ? d.ToString("dd/MM") : day.Date)</span>
            </div>
        }
    </div>
</div>
