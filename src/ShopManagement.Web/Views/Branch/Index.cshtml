@model List<ShopManagement.Web.Models.BranchListItemViewModel>
@{
    ViewData["Title"] = "Chi nhánh";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h1>Chi nhánh</h1>
    <a asp-action="Create" class="btn-primary">+ Thêm chi nhánh</a>
</div>

@if (!Model.Any())
{
    <div class="linear-card" style="text-align:center; padding:48px;">
        <p class="text-muted">Quán chưa có chi nhánh nào.</p>
        <a asp-action="Create" class="btn-primary">+ Thêm chi nhánh</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var b in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="linear-card" style="@(b.IsCurrent ? "border-color: var(--border-bright);" : "")">
                    <h4>@b.Name</h4>
                    <p class="text-muted">@b.Address @(string.IsNullOrEmpty(b.Phone) ? "" : "· " + b.Phone)</p>
                    @if (b.IsCurrent)
                    {
                        <p class="text-muted">Đang chọn</p>
                    }
                    else
                    {
                        <form asp-action="Select" asp-route-id="@b.Id" method="post">
                            <button type="submit" class="btn-secondary">Chọn chi nhánh này</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
