@model ShopManagement.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<!-- Page Header -->
<div style="margin-bottom: 28px;">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
        <a asp-action="Profile" style="color:var(--color-warm-gray); text-decoration:none; display:flex; align-items:center; gap:4px; font-size:13px; font-weight:600;">
            <span class="material-symbols-outlined" style="font-size:18px;">arrow_back</span>
            Cài đặt tài khoản
        </a>
    </div>
    <h1 style="margin:0; font-family:var(--font-display); font-weight:800; font-size:28px; color:var(--color-primary); display:flex; align-items:center; gap:10px;">
        <span class="material-symbols-outlined" style="font-size:30px;">lock</span>
        Đổi mật khẩu
    </h1>
    <p style="color:var(--color-warm-gray); margin:4px 0 0; font-size:14px;">Cập nhật mật khẩu mới để bảo mật tài khoản của bạn.</p>
</div>

<div class="linear-card" style="max-width:520px; padding:28px;">
    <form asp-action="ChangePassword" method="post" style="display:flex; flex-direction:column; gap:18px;">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin: 0; padding: 10px; border-radius: 8px; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2);"></div>

        <div style="display:flex; flex-direction:column; gap:6px;">
            <label asp-for="OldPassword" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Mật khẩu hiện tại</label>
            <div style="position:relative;">
                <span class="material-symbols-outlined" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--color-warm-gray); font-size:20px;">lock_open</span>
                <input asp-for="OldPassword" type="password" class="form-control" style="padding-left:44px; min-height:48px; border-radius:10px;" placeholder="••••••••" />
            </div>
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>

        <div style="display:flex; flex-direction:column; gap:6px;">
            <label asp-for="NewPassword" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Mật khẩu mới</label>
            <div style="position:relative;">
                <span class="material-symbols-outlined" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--color-warm-gray); font-size:20px;">lock</span>
                <input asp-for="NewPassword" type="password" class="form-control" style="padding-left:44px; min-height:48px; border-radius:10px;" placeholder="••••••••" />
            </div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div style="display:flex; flex-direction:column; gap:6px;">
            <label asp-for="ConfirmPassword" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Nhập lại mật khẩu mới</label>
            <div style="position:relative;">
                <span class="material-symbols-outlined" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--color-warm-gray); font-size:20px;">lock_reset</span>
                <input asp-for="ConfirmPassword" type="password" class="form-control" style="padding-left:44px; min-height:48px; border-radius:10px;" placeholder="••••••••" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div style="display:flex; gap:12px; margin-top:8px;">
            <button type="submit" class="btn-primary" style="font-weight:700; padding:12px 24px; border-radius:10px; font-size:14px; display:flex; align-items:center; justify-content:center; gap:8px;">
                <span class="material-symbols-outlined" style="font-size:18px;">check</span>
                Cập nhật mật khẩu
            </button>
            <a asp-action="Profile" class="btn-secondary" style="padding:12px 20px; border-radius:10px; font-size:14px; display:flex; align-items:center; gap:8px; text-decoration:none;">
                <span>Hủy</span>
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
