@model ShopManagement.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-shell" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; position: relative;">
    <main style="width: 100%; max-width: 440px; position: relative; z-index: 10;">
        <!-- Brand Header Section -->
        <div style="text-align: center; margin-bottom: 40px;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 96px; height: 96px; margin-bottom: 24px; border-radius: 50%; background: var(--color-bg-surface); border: 1px solid var(--border-normal); position: relative; overflow: hidden;">
                <div style="position: absolute; inset: 0; background: var(--color-primary); opacity: 0.05;"></div>
                <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 48px; font-variation-settings: 'FILL' 1;">restaurant</span>
            </div>
            <h1 style="font-family: var(--font-display); font-size: 32px; font-weight: 800; color: var(--color-primary); letter-spacing: -0.01em; margin: 0 0 8px;">ZôOS</h1>
            <p style="color: var(--color-warm-gray); font-size: 15px; margin: 0; font-weight: 500;">Tạo tài khoản và bắt đầu quản lý nhà hàng cao cấp</p>
        </div>

        <!-- Register Container -->
        <section class="linear-card" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(229, 231, 235, 0.7); border-radius: 16px; padding: 32px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(to right, transparent, rgba(230, 58, 0, 0.3), transparent);"></div>

            <form asp-action="Register" method="post" style="display: flex; flex-direction: column; gap: 16px;">
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin: 0; padding: 10px; border-radius: 8px; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2);"></div>

                <!-- Full Name -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label asp-for="FullName" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Họ và Tên</label>
                    <div style="position: relative;">
                        <span class="material-symbols-outlined" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--color-warm-gray); font-size: 20px;">badge</span>
                        <input asp-for="FullName" class="form-control" style="padding-left: 44px; min-height: 44px; border-radius: 10px;" placeholder="Nguyễn Văn A" autofocus />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <!-- Username -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label asp-for="Username" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Tên đăng nhập</label>
                    <div style="position: relative;">
                        <span class="material-symbols-outlined" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--color-warm-gray); font-size: 20px;">account_circle</span>
                        <input asp-for="Username" class="form-control" style="padding-left: 44px; min-height: 44px; border-radius: 10px;" placeholder="admin_bistro" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label asp-for="Email" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Địa chỉ Email</label>
                    <div style="position: relative;">
                        <span class="material-symbols-outlined" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--color-warm-gray); font-size: 20px;">mail</span>
                        <input asp-for="Email" class="form-control" style="padding-left: 44px; min-height: 44px; border-radius: 10px;" placeholder="manager@emberbistro.vn" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label asp-for="Password" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Mật khẩu</label>
                    <div style="position: relative;">
                        <span class="material-symbols-outlined" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--color-warm-gray); font-size: 20px;">lock</span>
                        <input asp-for="Password" type="password" id="registerPassword" class="form-control" style="padding-left: 44px; padding-right: 44px; min-height: 44px; border-radius: 10px;" placeholder="••••••••" />
                        <button type="button" onclick="toggleRegPassword()" style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--color-warm-gray); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0;">
                            <span class="material-symbols-outlined" id="regPasswordIcon" style="font-size: 20px;">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label asp-for="ConfirmPassword" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-warm-gray); font-weight: 700;">Nhập lại mật khẩu</label>
                    <div style="position: relative;">
                        <span class="material-symbols-outlined" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--color-warm-gray); font-size: 20px;">lock_reset</span>
                        <input asp-for="ConfirmPassword" type="password" id="registerConfirmPassword" class="form-control" style="padding-left: 44px; min-height: 44px; border-radius: 10px;" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Action Button -->
                <button type="submit" class="btn-primary" style="font-weight: 700; width: 100%; min-height: 48px; border-radius: 10px; font-size: 15px; margin-top: 12px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <span>Đăng ký tài khoản</span>
                    <span class="material-symbols-outlined" style="font-size: 20px; font-weight: bold;">arrow_forward</span>
                </button>
            </form>

            <!-- Registration Prompt -->
            <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border-normal); text-align: center;">
                <p style="color: var(--color-warm-gray); font-size: 14px; margin-bottom: 16px; font-weight: 500;">Đã có tài khoản ZôOS?</p>
                <a asp-action="Login" class="btn-secondary" style="display: inline-flex; align-items: center; justify-content: center; border-radius: 9999px; padding: 8px 24px; border: 1px solid var(--color-primary); color: var(--color-primary); font-size: 13px; font-weight: 700; text-decoration: none; min-height: 38px; transition: all 0.2s;">
                    Đăng nhập ngay
                </a>
            </div>
        </section>

        <!-- Footer Links -->
        <footer style="margin-top: 40px; display: flex; justify-content: center; gap: 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-warm-gray);">
            <a href="#" style="color: inherit; text-decoration: none;">Điều khoản dịch vụ</a>
            <a href="#" style="color: inherit; text-decoration: none;">Chính sách bảo mật</a>
            <a href="#" style="color: inherit; text-decoration: none;">Hỗ trợ kỹ thuật</a>
        </footer>
    </main>

    <!-- Side Graphic for Visual Balance (Hidden on Mobile) -->
    <div style="position: fixed; right: 40px; bottom: 40px; opacity: 0.25; display: flex; flex-direction: column; align-items: flex-end; gap: 8px;" class="d-none d-lg-flex">
        <div style="width: 120px; height: 1px; background: var(--color-primary);"></div>
        <div style="width: 60px; height: 1px; background: var(--color-primary); opacity: 0.5;"></div>
        <span style="font-family: var(--font-display); font-size: 48px; color: var(--color-primary); writing-mode: vertical-rl; margin-top: 16px; select-none: none; font-weight: 700; letter-spacing: 0.1em;">EXPERIENCE</span>
    </div>
</div>

<script>
    function toggleRegPassword() {
        const passwordInput = document.getElementById('registerPassword');
        const passwordIcon = document.getElementById('regPasswordIcon');
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            passwordIcon.innerText = 'visibility_off';
        } else {
            passwordInput.type = 'password';
            passwordIcon.innerText = 'visibility';
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
