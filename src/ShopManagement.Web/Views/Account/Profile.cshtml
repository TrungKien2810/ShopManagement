@model ShopManagement.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Cài đặt tài khoản";
    var initials = !string.IsNullOrEmpty(Model.FullName) && Model.FullName.Length > 0
        ? Model.FullName[..1].ToUpper()
        : "U";
}

<!-- Page Header -->
<div style="margin-bottom: 28px;">
    <h1 style="margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 28px; color: var(--color-primary);">Cài đặt tài khoản</h1>
    <p style="color: var(--color-warm-gray); margin: 4px 0 0; font-size: 14px;">Quản lý thông tin cá nhân, bảo mật và tùy chỉnh trải nghiệm của bạn.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="display:flex; align-items:center; gap:10px;">
        <span class="material-symbols-outlined" style="font-size:18px;">check_circle</span>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="display:flex; align-items:center; gap:10px;">
        <span class="material-symbols-outlined" style="font-size:18px;">error</span>
        @TempData["Error"]
    </div>
}

<!-- Profile Header Card -->
<div class="linear-card" style="display:flex; align-items:center; gap:24px; padding:28px; margin-bottom:24px; flex-wrap:wrap;">
    <div style="position:relative;">
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:3px solid var(--color-primary);" />
        }
        else
        {
            <div style="width:80px; height:80px; border-radius:50%; background:var(--color-primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:32px; font-weight:900; font-family:var(--font-display); border:3px solid rgba(230,58,0,0.2);">@initials</div>
        }
        <div style="position:absolute; bottom:2px; right:2px; width:18px; height:18px; border-radius:50%; background:var(--color-emerald); border:2px solid var(--color-bg-surface);"></div>
    </div>
    <div style="flex:1; min-width:200px;">
        <h3 style="margin:0 0 4px; font-size:22px; font-weight:800; color:var(--color-warm-white);">@Model.FullName</h3>
        <p style="margin:0; color:var(--color-warm-gray); font-size:14px; font-weight:500;">@@@Model.Username</p>
    </div>
    <div style="display:flex; gap:24px; flex-wrap:wrap;">
        <div>
            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--color-warm-gray); font-weight:700; margin-bottom:4px;">Email</div>
            <div style="font-size:14px; font-weight:600; color:var(--color-warm-white);">@Model.Email</div>
        </div>
        <div>
            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--color-warm-gray); font-weight:700; margin-bottom:4px;">Trạng thái</div>
            <span class="badge badge-available" style="font-size:11px;">Hoạt động</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Personal Info + Avatar -->
    <div class="col-md-7">
        <!-- Personal Info Section -->
        <div class="linear-card" style="margin-bottom:24px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
                <span class="material-symbols-outlined" style="color:var(--color-primary); font-size:22px;">person</span>
                <h4 style="margin:0; font-family:var(--font-display); font-size:18px; font-weight:700;">Thông tin cá nhân</h4>
            </div>
            
            <div style="display:flex; flex-direction:column; gap:16px;">
                <div class="row g-3">
                    <div class="col-md-6 col-12">
                        <label class="form-label">Họ và Tên</label>
                        <div class="form-control" style="cursor:default; opacity:0.7;">@Model.FullName</div>
                    </div>
                    <div class="col-md-6 col-12">
                        <label class="form-label">Tên đăng nhập</label>
                        <div class="form-control" style="cursor:default; opacity:0.7;">@Model.Username</div>
                    </div>
                </div>
                <div>
                    <label class="form-label">Địa chỉ Email</label>
                    <div class="form-control" style="cursor:default; opacity:0.7;">@Model.Email</div>
                </div>
            </div>

            <!-- Avatar Upload -->
            <div style="margin-top:20px; padding-top:20px; border-top:1px solid var(--border-normal);">
                <label class="form-label">Cập nhật ảnh đại diện</label>
                <form asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
                    <input type="file" name="avatarFile" class="form-control" accept="image/*" style="flex:1; min-width:200px;" />
                    <button type="submit" class="btn-primary" style="padding:10px 20px; border-radius:8px; font-size:13px; white-space:nowrap;">
                        <span class="material-symbols-outlined" style="font-size:16px;">upload</span>
                        Cập nhật ảnh
                    </button>
                </form>
            </div>
        </div>

        <!-- Notifications Section -->
        <div class="linear-card">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
                <span class="material-symbols-outlined" style="color:var(--color-primary); font-size:22px;">notifications</span>
                <h4 style="margin:0; font-family:var(--font-display); font-size:18px; font-weight:700;">Thông báo</h4>
            </div>
            
            <div style="display:flex; flex-direction:column; gap:0;">
                <!-- Notification Toggle 1 -->
                <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 0; border-bottom:1px solid var(--border-subtle);">
                    <div>
                        <div style="font-weight:700; font-size:14px; color:var(--color-warm-white);">Đơn hàng mới</div>
                        <div style="font-size:12px; color:var(--color-warm-gray); margin-top:2px;">Thông báo ngay khi có đơn đặt bàn hoặc đặt món mới</div>
                    </div>
                    <label style="position:relative; display:inline-block; width:44px; height:24px; cursor:pointer;">
                        <input type="checkbox" checked style="opacity:0; width:0; height:0;" onchange="this.parentElement.querySelector('.toggle-track').classList.toggle('active')">
                        <span class="toggle-track active" style="position:absolute; inset:0; border-radius:12px; background:var(--color-emerald); transition:background 0.3s;"></span>
                        <span style="position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:#fff; transition:transform 0.3s; transform:translateX(20px);"></span>
                    </label>
                </div>
                <!-- Notification Toggle 2 -->
                <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 0; border-bottom:1px solid var(--border-subtle);">
                    <div>
                        <div style="font-weight:700; font-size:14px; color:var(--color-warm-white);">Báo cáo doanh thu hàng ngày</div>
                        <div style="font-size:12px; color:var(--color-warm-gray); margin-top:2px;">Gửi bản tóm tắt qua email vào cuối ngày làm việc</div>
                    </div>
                    <label style="position:relative; display:inline-block; width:44px; height:24px; cursor:pointer;">
                        <input type="checkbox" style="opacity:0; width:0; height:0;" onchange="this.parentElement.querySelector('.toggle-track').classList.toggle('active')">
                        <span class="toggle-track" style="position:absolute; inset:0; border-radius:12px; background:#d1d5db; transition:background 0.3s;"></span>
                        <span style="position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:#fff; transition:transform 0.3s;"></span>
                    </label>
                </div>
                <!-- Notification Toggle 3 -->
                <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 0;">
                    <div>
                        <div style="font-weight:700; font-size:14px; color:var(--color-warm-white);">Tin nhắn hệ thống</div>
                        <div style="font-size:12px; color:var(--color-warm-gray); margin-top:2px;">Thông tin về cập nhật phần mềm và bảo trì</div>
                    </div>
                    <label style="position:relative; display:inline-block; width:44px; height:24px; cursor:pointer;">
                        <input type="checkbox" checked style="opacity:0; width:0; height:0;" onchange="this.parentElement.querySelector('.toggle-track').classList.toggle('active')">
                        <span class="toggle-track active" style="position:absolute; inset:0; border-radius:12px; background:var(--color-emerald); transition:background 0.3s;"></span>
                        <span style="position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:#fff; transition:transform 0.3s; transform:translateX(20px);"></span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Security + Danger Zone -->
    <div class="col-md-5">
        <!-- Security Section -->
        <div class="linear-card" style="margin-bottom:24px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
                <span class="material-symbols-outlined" style="color:var(--color-primary); font-size:22px;">shield</span>
                <h4 style="margin:0; font-family:var(--font-display); font-size:18px; font-weight:700;">Bảo mật</h4>
            </div>
            
            <!-- Change Password -->
            <div style="padding:16px; background:var(--color-bg-surface); border-radius:10px; border:1px solid var(--border-normal); margin-bottom:16px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <div style="font-weight:700; font-size:14px; color:var(--color-warm-white); display:flex; align-items:center; gap:8px;">
                            <span class="material-symbols-outlined" style="font-size:18px; color:var(--color-warm-gray);">lock</span>
                            Thay đổi mật khẩu
                        </div>
                        <div style="font-size:12px; color:var(--color-warm-gray); margin-top:4px; margin-left:26px;">Lần cập nhật cuối: gần đây</div>
                    </div>
                    <a asp-action="ChangePassword" class="btn-secondary" style="padding:6px 14px; font-size:12px; border-radius:8px; min-height:34px;">Đổi</a>
                </div>
            </div>
            
            <!-- 2FA Section -->
            <div style="padding:16px; background:var(--color-bg-surface); border-radius:10px; border:1px solid var(--border-normal);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <div style="font-weight:700; font-size:14px; color:var(--color-warm-white); display:flex; align-items:center; gap:8px;">
                            <span class="material-symbols-outlined" style="font-size:18px; color:var(--color-warm-gray);">security</span>
                            Xác thực 2 yếu tố (2FA)
                        </div>
                        <div style="font-size:12px; color:var(--color-warm-gray); margin-top:4px; margin-left:26px;">Tăng cường bảo mật tài khoản của bạn</div>
                    </div>
                    <span class="badge badge-cancelled" style="font-size:10px;">Chưa bật</span>
                </div>
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="linear-card" style="border-color:rgba(239,68,68,0.3); background:rgba(239,68,68,0.05);">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                <span class="material-symbols-outlined" style="color:#ef4444; font-size:22px;">warning</span>
                <h4 style="margin:0; font-family:var(--font-display); font-size:18px; font-weight:700; color:#ef4444;">Vùng nguy hiểm</h4>
            </div>
            <p style="color:var(--color-warm-gray); font-size:13px; margin:0 0 16px; line-height:1.6;">
                Vô hiệu hóa hoặc xóa vĩnh viễn tài khoản quản lý này. Hành động này không thể hoàn tác.
            </p>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <button type="button" class="btn-secondary" style="padding:8px 16px; font-size:13px; border-radius:8px; color:var(--color-warm-gray); border-color:var(--border-normal);">
                    <span class="material-symbols-outlined" style="font-size:16px;">block</span>
                    Vô hiệu hóa
                </button>
                <button type="button" class="btn-secondary" style="padding:8px 16px; font-size:13px; border-radius:8px; color:#ef4444; border-color:rgba(239,68,68,0.3);">
                    <span class="material-symbols-outlined" style="font-size:16px;">delete_forever</span>
                    Xóa tài khoản
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .toggle-track { cursor: pointer; }
    .toggle-track.active { background: var(--color-emerald) !important; }
    .toggle-track.active + span { transform: translateX(20px) !important; }
</style>
