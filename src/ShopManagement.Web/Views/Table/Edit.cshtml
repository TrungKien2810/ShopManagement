@model ShopManagement.Web.Models.TableFormViewModel
@{
    ViewData["Title"] = "Sửa bàn";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Sửa bàn</h1>
        <p class="page-subtitle">Cập nhật thông tin bàn</p>
    </div>
    <a asp-action="Index" class="btn-secondary">← Quay lại</a>
</div>

<div class="linear-card" style="max-width:480px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 12px;"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Capacity" class="form-label"></label>
            <input asp-for="Capacity" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="AreaId" class="form-label"></label>
            <select asp-for="AreaId" class="form-select">
                <option value="">-- Không chọn --</option>
                @foreach (var area in Model.AreaOptions)
                {
                    <option value="@area.Id">@area.Name</option>
                }
            </select>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:24px; padding-top:16px; border-top:1px solid var(--border-normal);">
            <div>
                <button type="button" onclick="confirmDelete()" class="btn-danger" style="padding:10px 18px; font-size:13px; border-radius:10px; font-weight:700; border:none;">Xóa bàn</button>
            </div>
            <div style="display:flex; gap:10px;">
                <a asp-action="Index" class="btn-secondary" style="padding:10px 18px; font-size:13px; border-radius:10px; min-height:unset; display:inline-flex; align-items:center; font-weight:600; text-decoration:none;">Hủy</a>
                <button type="submit" class="btn-primary" style="padding:10px 22px; font-size:13px; border-radius:10px; min-height:unset; font-weight:700; border:none;">Lưu thay đổi</button>
            </div>
        </div>
    </form>
    <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:none;"></form>
    <script>
        function confirmDelete() {
            if (confirm("Bạn có chắc chắn muốn xóa bàn này? Hành động này không thể hoàn tác.")) {
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
