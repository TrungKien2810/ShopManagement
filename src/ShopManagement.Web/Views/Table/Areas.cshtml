@model List<ShopManagement.Web.Models.TableAreaOption>
@{
    ViewData["Title"] = "Khu vực bàn";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Khu vực bàn</h1>
        <p class="page-subtitle">Quản lý khu vực và phân bổ bàn</p>
    </div>
    <a asp-action="Index" class="btn-secondary">← Về sơ đồ bàn</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="linear-card" style="border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.08); color:#ef4444; margin-bottom:16px;">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-md-7">
        <div class="linear-card">
            <div style="overflow-x:auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tên khu vực</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var area in Model)
                        {
                            <tr>
                                <td>@area.Name</td>
                                <td>
                                    <span class="badge @(area.IsActive ? "badge-available" : "badge-pending")">@(area.IsActive ? "Hoạt động" : "Đã ẩn")</span>
                                </td>
                                <td style="display:flex; gap:6px;">
                                    <form asp-action="ToggleArea" asp-route-id="@area.Id" method="post">
                                        <button type="submit" class="btn-secondary" style="padding:4px 10px;">@(area.IsActive ? "Ẩn" : "Bật")</button>
                                    </form>
                                    <form asp-action="DeleteArea" asp-route-id="@area.Id" method="post" data-confirm="Bạn có chắc chắn muốn xóa khu vực này? Các bàn thuộc khu vực này sẽ được giữ lại nhưng sẽ không thuộc khu vực nào.">
                                        <input type="hidden" name="deleteMode" value="keepTables" />
                                        <button type="submit" class="btn-secondary" style="padding:4px 10px; color:#ef4444;">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="linear-card">
            <h4>Thêm khu vực</h4>
            <form asp-action="CreateArea" method="post" style="margin-top:12px;">
                <div class="mb-3">
                    <label class="form-label">Tên khu vực</label>
                    <input name="Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Thứ tự</label>
                    <input name="SortOrder" type="number" class="form-control" value="0" />
                </div>
                <button type="submit" class="btn-primary">Thêm</button>
            </form>
        </div>
    </div>
</div>

