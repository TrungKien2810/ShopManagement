@model ShopManagement.Web.Models.OrderPageViewModel
@using ShopManagement.Domain.Enums
@{
    ViewData["Title"] = $"Đơn hàng - {Model.TableName}";
    var canApprove = User.IsInRole("Owner") || User.IsInRole("Manager");
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:28px; flex-wrap:wrap; gap:16px;">
    <div>
        <h1 style="margin:0; font-family:var(--font-display); font-size:28px; font-weight:800; color:var(--color-primary); display:flex; align-items:center; gap:10px;">
            <span class="material-symbols-outlined" style="font-size:30px;">receipt_long</span>
            <span>Bàn @Model.TableName</span>
        </h1>
        <p style="color:var(--color-warm-gray); margin:4px 0 0; font-size:14px;">Chọn các món ăn từ thực đơn bên dưới để thêm vào đơn hàng của bàn.</p>
    </div>
    <a asp-controller="Table" asp-action="Index" class="btn-secondary" style="border-radius:8px; padding:10px 18px; font-size:13px; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:6px;">
        <span class="material-symbols-outlined" style="font-size:18px;">arrow_back</span>
        <span>Quay lại sơ đồ bàn</span>
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="linear-card" style="border-color: rgba(239,68,68,0.3); margin-bottom:20px; padding: 14px 20px; background: rgba(239,68,68,0.08); color: #ef4444; border-radius: 12px; font-weight: 500;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">error</span>
            <span>@TempData["Error"]</span>
        </div>
    </div>
}

<div class="order-layout" style="display:grid; grid-template-columns: 1.5fr 1fr; gap:28px; align-items:start;">
    <!-- Left column: Menu Products -->
    <div>
        @foreach (var category in Model.Categories)
        {
            var availableProducts = category.Products.Where(p => p.IsAvailable).ToList();
            if (availableProducts.Count == 0) continue;

            <div style="margin: 32px 0 16px; border-bottom: 1px solid var(--border-normal); padding-bottom: 8px; display:flex; align-items:center; gap:8px;">
                <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 20px;">restaurant</span>
                <h4 style="margin: 0; font-family: var(--font-display); font-size: 18px; font-weight: 700; color:var(--color-warm-white);">@category.Name</h4>
            </div>

            <div class="row g-3">
                @foreach (var p in availableProducts)
                {
                    <div class="col-md-4 col-sm-6 col-6">
                        <div class="linear-card" style="background: #ffffff; border: 1px solid var(--border-normal); border-radius: 12px; display:flex; flex-direction:column; justify-content:space-between; min-height:280px; padding:0; overflow:hidden; transition: all 0.25s ease;"
                             onmouseover="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 8px 20px rgba(230, 58, 0, 0.1)';"
                             onmouseout="this.style.borderColor='var(--border-normal)'; this.style.boxShadow='none';">

                            <!-- Image Frame -->
                            <div style="width:100%; height:110px; overflow:hidden; background:var(--color-bg-surface); display:flex; align-items:center; justify-content:center; border-bottom:1px solid var(--border-normal); position:relative;">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined" style="font-size:32px; color:rgba(107,114,128,0.35);">restaurant</span>
                                }
                            </div>

                            <!-- Card Body -->
                            <div style="padding:14px; display:flex; flex-direction:column; flex-grow:1; justify-content:space-between; gap:10px;">
                                <div>
                                    <h4 style="font-size:14px; margin: 0 0 6px; font-weight:700; color:var(--color-warm-white); line-height:1.35; height:38px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">@p.Name</h4>
                                    <p style="color: var(--color-amber); font-weight:800; margin: 0; font-size:14px; font-family:var(--font-display);">@p.Price.ToString("N0") đ</p>
                                </div>

                                <form asp-action="AddItem" method="post" style="display:flex; gap:6px; align-items:center; margin-top:auto;">
                                    <input type="hidden" name="orderId" value="@Model.Order.Id" />
                                    <input type="hidden" name="tableId" value="@Model.TableId" />
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:50px; padding:5px 6px; text-align:center; font-size:13px; height:32px;" />
                                    <button type="submit" class="btn-primary" style="padding:0 12px; font-size:12px; height:32px; border-radius:6px; font-weight:700; border:none; display:flex; align-items:center; justify-content:center; gap:4px; flex-grow:1; cursor:pointer;">
                                        <span class="material-symbols-outlined" style="font-size:14px; font-weight:bold;">add</span>
                                        Thêm
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Right column: Current Order Summary -->
    <div class="linear-card glow-amber" id="order-summary" style="position:sticky; top:24px; background:#ffffff; border:1px solid var(--border-normal); border-radius:20px; padding:24px;">
        <h4 style="margin:0 0 16px; font-family:var(--font-display); font-size:20px; font-weight:800; color:var(--color-warm-white); display:flex; align-items:center; gap:8px;">
            <span class="material-symbols-outlined" style="color:var(--color-primary); font-size:22px;">shopping_bag</span>
            Đơn hàng hiện tại
        </h4>

        @if (Model.Order.NeedsApprovalCount > 0)
        {
            <div class="badge badge-pending" style="margin-bottom:16px; padding:4px 10px; display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600;">
                <span class="material-symbols-outlined" style="font-size:16px;">notification_important</span>
                @Model.Order.NeedsApprovalCount món cần duyệt
            </div>
        }

        <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--border-normal); border-radius: 8px; background:var(--color-bg-surface); padding:0 12px; margin-bottom:20px;">
            <table class="table" style="width:100%; border-collapse:collapse;">
                <tbody>
                    @foreach (var item in Model.Order.Items)
                    {
                        <tr style="border-bottom:1px solid var(--border-subtle);">
                            <td style="padding:12px 0;">
                                <div style="font-weight:600; color:var(--color-warm-white); font-size:14px;">@item.ProductName</div>
                                <span class="badge @(item.Status switch {
                                    OrderItemStatus.NeedsApproval => "badge-pending animate-pulse-border",
                                    OrderItemStatus.Cancelled => "badge-cancelled",
                                    OrderItemStatus.Served => "badge-available",
                                    _ => "badge-available"
                                })" style="font-size:10px; padding:2px 6px; margin-top:4px; display:inline-block;">
                                    @(item.Status switch {
                                        OrderItemStatus.NeedsApproval => "Cần duyệt",
                                        OrderItemStatus.Served => "Đã lên món",
                                        OrderItemStatus.Cancelled => "Đã hủy",
                                        _ => "Chờ phục vụ"
                                    })
                                </span>
                            </td>
                            <td style="padding:12px 4px; white-space:nowrap; vertical-align:middle;">
                                <form asp-action="UpdateItem" method="post" style="display:flex; gap:4px; align-items:center; margin:0;">
                                    <input type="hidden" name="orderId" value="@Model.Order.Id" />
                                    <input type="hidden" name="tableId" value="@Model.TableId" />
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="width:52px; padding:4px 6px; text-align:center; font-size:13px;" onchange="this.form.submit()" />
                                </form>
                            </td>
                            <td style="padding:12px 4px; text-align:right; white-space:nowrap; vertical-align:middle; font-weight:700; color:var(--color-amber); font-size:14px;">
                                @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                            </td>
                            <td style="padding:12px 0 12px 8px; vertical-align:middle; text-align:right;">
                                <div style="display:flex; gap:4px; justify-content:flex-end;">
                                    @if (item.Status == OrderItemStatus.NeedsApproval && canApprove)
                                    {
                                        <form asp-action="Approve" method="post" style="margin:0;">
                                            <input type="hidden" name="orderId" value="@Model.Order.Id" />
                                            <input type="hidden" name="tableId" value="@Model.TableId" />
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn-secondary" style="padding:4px 8px; font-size:11px; color: var(--color-emerald); border-color:rgba(34,197,94,0.2); display:flex; align-items:center;" title="Duyệt món">
                                                <span class="material-symbols-outlined" style="font-size:14px;">check</span>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="DeleteItem" method="post" data-confirm="Bạn có chắc chắn muốn xóa món này khỏi đơn hàng?" style="margin:0;">
                                        <input type="hidden" name="orderId" value="@Model.Order.Id" />
                                        <input type="hidden" name="tableId" value="@Model.TableId" />
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="btn-secondary" style="padding:4px 8px; font-size:11px; color:#ef4444; border-color:rgba(239,68,68,0.25); display:flex; align-items:center;" title="Xóa món">
                                            <span class="material-symbols-outlined" style="font-size:14px;">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="border-top:1px solid var(--border-normal); padding-top:14px; margin-top:12px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:13px; color:var(--color-warm-gray);">
                <span>Đã chấp nhận</span>
                <span style="color:var(--color-warm-white); font-weight:600;">@Model.Order.AcceptedAmount.ToString("N0") đ</span>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; border-top:1.5px dashed var(--border-normal); padding-top:12px;">
                <span style="font-size:13px; color:var(--color-warm-gray); font-weight:800; letter-spacing:0.04em;">TỔNG CỘNG TIỀN</span>
                <span style="color: var(--color-amber); font-family:var(--font-display); font-size:26px; font-weight:900; text-shadow:0 0 12px rgba(244,181,65,0.35);">@Model.Order.TotalAmount.ToString("N0") đ</span>
            </div>
        </div>

        <a asp-controller="Payment" asp-action="Checkout" asp-route-orderId="@Model.Order.Id" class="btn-primary" style="display:flex; align-items:center; justify-content:center; gap:8px; text-align:center; margin-top:20px; padding:12px; font-weight:700; border-radius:8px; text-decoration:none; border:none; background: linear-gradient(135deg, var(--color-ember-bright), var(--color-ember)); color:#fff; box-shadow:0 4px 15px rgba(194,65,12,0.25);">
            <span class="material-symbols-outlined">payments</span>
            Thanh toán
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/shop")
            .withAutomaticReconnect()
            .build();

        connection.on("OrderUpdated", function () {
            location.reload();
        });

        connection.start()
            .then(() => connection.invoke("JoinTableGroup", "@Model.TableId"))
            .catch(err => console.error(err));
    </script>
}
