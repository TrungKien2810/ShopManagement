@model ShopManagement.Web.Models.CreateShopViewModel
@{
    ViewData["Title"] = "Tạo quán mới";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Tạo quán mới</h1>
        <p class="page-subtitle">Điền thông tin để đăng ký quán</p>
    </div>
    <a asp-action="Index" class="btn-secondary">← Quay lại</a>
</div>

<div class="linear-card" style="max-width:520px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 12px;"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>

        <button type="submit" class="btn-primary">Tạo quán</button>
        <a asp-action="Index" class="btn-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
