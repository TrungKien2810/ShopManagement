@{
    var isAuthed = User?.Identity?.IsAuthenticated ?? false;
    string Current() => $"{ViewContext.RouteData.Values["controller"]}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZôOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@if (isAuthed)
{
    <div class="app-shell" id="app-shell">
        <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
        <aside class="app-sidebar" id="app-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" style="text-decoration:none;">
                <div style="font-family:var(--font-display); font-size: 24px; font-weight:900; color:var(--color-amber); line-height: 1.1;">ZôOS</div>
                <div style="font-size:10px; color:var(--color-warm-gray); font-weight:600; letter-spacing:0.08em; text-transform:uppercase; margin-top:2px;">Premium Management</div>
            </a>
            
            @await Component.InvokeAsync("CurrentTenant")
            
            <nav style="display:flex; flex-direction:column; justify-content:space-between; flex-grow:1; margin-top:12px;">
                <div style="display:flex; flex-direction:column; gap:2px;">
                    <a class="app-nav-link @(Current() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <span class="material-symbols-outlined">dashboard</span>
                        <span>Dashboard</span>
                    </a>
                    <a class="app-nav-link @(Current() == "Table" ? "active" : "")" asp-controller="Table" asp-action="Index">
                        <span class="material-symbols-outlined">table_restaurant</span>
                        <span>Bàn / Sơ đồ</span>
                    </a>
                    <a class="app-nav-link @(Current() == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">
                        <span class="material-symbols-outlined">restaurant_menu</span>
                        <span>Thực đơn</span>
                    </a>
                    <a class="app-nav-link @(Current() == "Order" ? "active" : "")" asp-controller="Order" asp-action="Index">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <span>Đơn hàng</span>
                    </a>
                    <a class="app-nav-link @(Current() == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                        <span class="material-symbols-outlined">bar_chart</span>
                        <span>Báo cáo</span>
                    </a>
                    <a class="app-nav-link @(Current() == "Shop" && ViewContext.RouteData.Values["action"]?.ToString() != "Settings" ? "active" : "")" asp-controller="Shop" asp-action="Index">
                        <span class="material-symbols-outlined">store</span>
                        <span>Cửa hàng</span>
                    </a>
                    <a class="app-nav-link @(Current() == "Branch" ? "active" : "")" asp-controller="Branch" asp-action="Index">
                        <span class="material-symbols-outlined">account_tree</span>
                        <span>Chi nhánh</span>
                    </a>
                </div>
                
                <div style="display:flex; flex-direction:column; gap:8px; margin-top: auto; padding-top:20px; border-top:1px solid var(--color-border-copper);">
                    <a href="/Order/Index" class="btn-primary" style="font-weight:800; border-radius:12px; padding:12px; display:flex; align-items:center; justify-content:center; gap:8px; text-decoration:none; min-height:44px;">
                        <span class="material-symbols-outlined" style="font-size:20px; font-weight:bold;">point_of_sale</span>
                        <span>MÀN HÌNH BÁN HÀNG</span>
                    </a>
                    <div style="display:flex; flex-direction:column; gap:2px; margin-top: 8px;">
                        <a class="app-nav-link @(Current() == "Shop" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Shop" asp-action="Settings" style="padding:8px 12px; font-size:13px; border-radius:8px;">
                            <span class="material-symbols-outlined" style="font-size:20px;">settings</span>
                            <span>Thiết lập hệ thống</span>
                        </a>
                        <a href="https://support.zoos.vn" target="_blank" class="app-nav-link" style="padding:8px 12px; font-size:13px; border-radius:8px;">
                            <span class="material-symbols-outlined" style="font-size:20px;">help</span>
                            <span>Trung tâm hỗ trợ</span>
                        </a>
                    </div>
                </div>
            </nav>
        </aside>
        <div class="app-main">
            <header class="app-topbar">
                <div style="display:flex; align-items:center; gap:16px;">
                    <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Mở/đóng menu" aria-expanded="false" aria-controls="app-sidebar" style="background:none; border:none; color:var(--color-warm-white); font-size:20px; cursor:pointer;">&#9776;</button>
                    <div style="position:relative; display:flex; align-items:center;">
                        <span class="material-symbols-outlined" style="position:absolute; left:14px; color:var(--color-warm-gray); font-size:18px;">search</span>
                        <input type="text" placeholder="Tìm kiếm bàn, món nhậu..." style="background:var(--color-bg-surface); border:1px solid var(--border-normal); color:var(--color-warm-white); border-radius:9999px; padding:10px 16px 10px 42px; font-size:13px; width:min(280px, 35vw); min-width:120px; flex-shrink:1; outline:none; transition:all 0.25s cubic-bezier(0.4, 0, 0.2, 1);" onfocus="this.style.borderColor='var(--color-ember)'; this.style.boxShadow='0 0 0 3px rgba(230, 58, 0, 0.1)';" onblur="this.style.borderColor='var(--border-normal)'; this.style.boxShadow='none';" />
                    </div>
                </div>
                <div style="display:flex; align-items:center; gap:14px;">
                    <a href="/Shop" class="btn-secondary topbar-branch-switcher" style="padding:8px 16px; font-size:12px; font-weight:700; min-height:38px; border-radius:10px; border:1px solid rgba(230, 58, 0, 0.25); color:var(--color-ember); display:flex; align-items:center; gap:6px; background:rgba(230, 58, 0, 0.04); text-decoration:none; transition:all 0.2s;" onmouseover="this.style.background='rgba(230, 58, 0, 0.1)'; this.style.borderColor='var(--color-ember)';" onmouseout="this.style.background='rgba(230, 58, 0, 0.04)'; this.style.borderColor='rgba(230, 58, 0, 0.25)';">
                        <span class="material-symbols-outlined" style="font-size:16px;">swap_horiz</span>
                        <span>Đổi chi nhánh</span>
                    </a>

                    <button class="btn-secondary topbar-notif-btn" style="border:1px solid var(--border-normal); padding:8px; min-height:unset; color:var(--color-warm-gray); display:flex; align-items:center; justify-content:center; border-radius:50%; width:38px; height:38px; background:#fff; cursor:pointer; transition:all 0.2s;" onmouseover="this.style.color='var(--color-ember)'; this.style.borderColor='var(--color-ember)';" onmouseout="this.style.color='var(--color-warm-gray)'; this.style.borderColor='var(--border-normal)';">
                        <span class="material-symbols-outlined" style="font-size:20px;">notifications</span>
                    </button>

                    <a href="/Account/Profile" style="display:flex; align-items:center; gap:10px; padding:6px 12px; border-radius:999px; background:#fff; border:1px solid var(--border-normal); text-decoration:none; transition:all 0.2s;" onmouseover="this.style.borderColor='var(--color-ember)';" onmouseout="this.style.borderColor='var(--border-normal)';">
                        <div style="width:26px; height:26px; border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, var(--color-ember-bright) 0%, var(--color-ember) 100%); color:#fff; font-size:12px; font-weight:900; text-transform:uppercase; box-shadow:0 2px 8px rgba(230,58,0,0.25);">
                            @(User?.Identity?.Name != null && User.Identity.Name.Length > 0 ? User.Identity.Name[..1] : "U")
                        </div>
                        <span style="font-size:13px; font-weight:700; color:var(--color-warm-white); max-width:100px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(User?.Identity?.Name ?? "User")</span>
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" style="margin:0; display:inline;">
                        <button type="submit" class="btn-secondary" style="border:1px solid var(--border-normal); padding:8px; min-height:unset; color:var(--color-warm-gray); display:flex; align-items:center; justify-content:center; border-radius:50%; width:38px; height:38px; background:#fff; cursor:pointer; transition:all 0.2s;" title="Đăng xuất" onmouseover="this.style.color='#ef4444'; this.style.borderColor='rgba(239,68,68,0.3)'; this.style.background='rgba(239,68,68,0.05)';" onmouseout="this.style.color='var(--color-warm-gray)'; this.style.borderColor='var(--border-normal)'; this.style.background='#fff';">
                            <span class="material-symbols-outlined" style="font-size:20px;">logout</span>
                        </button>
                    </form>
                </div>
            </header>
            <main class="app-content">
                <partial name="_FlashMessages" />
                @RenderBody()
            </main>
            <footer style="padding:16px 24px; border-top:1px solid var(--color-border-copper); display:flex; justify-content:space-between; align-items:center; font-size:11px; color:var(--color-warm-gray); flex-wrap:wrap; gap:8px;">
                <span>© @DateTime.Now.Year ZôOS Premium Management. All rights reserved.</span>
                <div style="display:flex; gap:16px;">
                    <a href="#" style="color:inherit; text-decoration:none;">Privacy Policy</a>
                    <a href="#" style="color:inherit; text-decoration:none;">Terms of Service</a>
                    <a href="#" style="color:inherit; text-decoration:none;">Contact Support</a>
                </div>
            </footer>
        </div>
    </div>
}
else
{
    <main>
        @RenderBody()
    </main>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
