            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"D:/Edu/Project/OptimizedTokenProject/dist/adapters/copilot-chat/pretooluse.js\"",
            "timeout": 30,
            "statusMessage": "Scope guard checking..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"D:/Edu/Project/OptimizedTokenProject/dist/adapters/copilot-chat/stop.js\"",
            "timeout": 600,
            "statusMessage": "Verifying..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"D:/Edu/Project/OptimizedTokenProject/dist/adapters/copilot-chat/session.js\"",
            "timeout": 30
          }
        ]
