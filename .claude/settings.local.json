{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "WebSearch",
      "Bash(Get-ChildItem -Path \"d:\\\\Edu\\\\Project\" -Directory)",
      "Bash(Select-Object Name)",
      "PowerShell(\\(Get-Content \"D:\\\\Edu\\\\Project\\\\ShopManagement\\\\.claude\\\\settings.local.json\" | ConvertFrom-Json\\).hooks | Select-Object -ExpandProperty UserPromptSubmit | Select-Object -ExpandProperty hooks | ForEach-Object {$_.command})",
      "Bash(dotnet --version)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
